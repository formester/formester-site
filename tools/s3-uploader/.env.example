# Point this at the same S3 bucket the CMS already uses today
# (@strapi/provider-upload-aws-s3), or a dedicated bucket/prefix.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
# Only needed for non-AWS S3-compatible endpoints (R2, MinIO, ...). Leave
# unset for a real AWS S3 bucket.
S3_ENDPOINT=
# Optional: scope both browsing and new uploads to this one folder — useful
# if you're sharing a bucket with Strapi and want this tool to stay out of
# its way. Leave unset to browse/upload at the bucket root.
S3_PREFIX=
# Local server port (default 5757)
PORT=
