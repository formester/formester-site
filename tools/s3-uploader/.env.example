# Prefilled to match docker-compose.yml's local MinIO setup — run
# `docker compose up -d` in this directory, then `cp .env.example .env`
# and these values work as-is. Swap them for real AWS S3 credentials
# (and drop S3_ENDPOINT) to point this tool at the production bucket
# instead.
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=formester-uploads
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
# Optional: scope both browsing and new uploads to this one folder — useful
# if you're sharing a bucket with Strapi and want this tool to stay out of
# its way. Leave unset to browse/upload at the bucket root.
S3_PREFIX=
# Local server port (default 5757)
PORT=
