      "__component": "micro-components.raw-html",
      "markup": "<style>\n.fpl{--fpl-font:'Inter',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,sans-serif;\n--fpl-fg1:#101828;--fpl-fg2:#475467;--fpl-fg3:#697586;--fpl-bg:#fff;--fpl-grey25:#fcfcfd;--fpl-grey50:#f9fafb;--fpl-grey100:#f2f4f7;\n--fpl-violet25:#f7f3ff;--fpl-violet50:#f0ebfa;--fpl-violet100:#f4ebff;--fpl-violet500:#7f56d9;--fpl-violet600:#6434d0;--fpl-violet700:#53389e;\n--fpl-border:#eaecf0;--fpl-border-dk:#d0d5dd;--fpl-r:8px;--fpl-r-lg:12px;--fpl-r-xl:16px;--fpl-r-full:9999px;\n--fpl-shadow-xs:0 1px 2px 0 rgba(16,24,40,.05);--fpl-shadow-lg:0 8px 24px -4px rgba(16,24,40,.08),0 4px 8px -2px rgba(16,24,40,.04);\n--fpl-accent:#21759b}\n.fpl,.fpl *{box-sizing:border-box}\n.fpl{font-family:var(--fpl-font);color:var(--fpl-fg1);font-size:16px;line-height:1.5;-webkit-font-smoothing:antialiased}\n.fpl h1,.fpl h2,.fpl h3,.fpl h4{color:var(--fpl-fg1);margin:0 0 12px;letter-spacing:-.02em;font-weight:600;line-height:1.2}\n.fpl h2{font-size:clamp(26px,3.2vw,34px)}.fpl h3{font-size:20px}.fpl h4{font-size:17px}\n.fpl p{color:var(--fpl-fg2);margin:0 0 16px;font-size:16px;line-height:1.7}\n.fpl a{color:var(--fpl-violet600);text-decoration:none}.fpl a:hover{color:var(--fpl-violet700)}\n.fpl-container{max-width:1160px;margin:0 auto;padding:0 24px}\n.fpl-section{padding:72px 0}\n.fpl-section--grey{background:var(--fpl-grey50);border-top:1px solid var(--fpl-border);border-bottom:1px solid var(--fpl-border)}\n.fpl-head{max-width:680px;margin:0 auto 44px;text-align:center}\n.fpl-head p{font-size:17px}\n.fpl-eyebrow{display:inline-flex;align-items:center;gap:7px;font-size:12px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--fpl-violet600);margin-bottom:14px}\n.fpl-btn{display:inline-flex;align-items:center;gap:8px;font-weight:600;font-size:15px;padding:12px 22px;border-radius:var(--fpl-r);border:1px solid transparent;cursor:pointer;transition:all .14s ease}\n.fpl-btn--primary{background:var(--fpl-violet600);color:#fff}.fpl-btn--primary:hover{background:var(--fpl-violet700);color:#fff}\n.fpl-btn--secondary{background:#fff;color:var(--fpl-fg1);border-color:var(--fpl-border-dk);box-shadow:var(--fpl-shadow-xs)}.fpl-btn--secondary:hover{background:var(--fpl-grey50)}\n/* hero */\n.fpl-hero{position:relative;overflow:hidden;padding:80px 0 56px}\n.fpl-hero::before{content:\"\";position:absolute;inset:0 0 auto 0;height:560px;background:radial-gradient(ellipse 680px 320px at 82% 8%,rgba(33,117,155,.07),transparent 70%),linear-gradient(180deg,var(--fpl-violet25),rgba(247,243,255,0));pointer-events:none}\n.fpl-hero-inner{position:relative;display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);gap:52px;align-items:center}\n.fpl-pill{display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--fpl-border);box-shadow:var(--fpl-shadow-xs);border-radius:var(--fpl-r-full);padding:5px 14px 5px 6px;font-size:13px;font-weight:500;color:#344054;margin-bottom:20px}\n.fpl-pill img{width:18px;height:18px}\n.fpl-hero h1{font-size:clamp(36px,4.6vw,52px);line-height:1.08;margin-bottom:18px;text-wrap:balance}\n.fpl-hero h1 i{font-style:normal;color:var(--fpl-violet600)}\n.fpl-lede{font-size:18px;line-height:1.6;color:var(--fpl-fg2);margin-bottom:26px;max-width:540px}\n.fpl-hero-ctas{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:22px}\n.fpl-hero-meta{display:flex;flex-wrap:wrap;gap:10px;font-size:14px;color:var(--fpl-fg3)}.fpl-hero-meta strong{color:var(--fpl-fg1)}\n.fpl-hero-art{display:flex;justify-content:center}.fpl-hero-art img{width:100%;max-width:440px;height:auto}\n/* split content rows */\n.fpl-split{display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}\n.fpl-split--rev .fpl-split-media{order:2}\n.fpl-split-media img{width:100%;max-width:460px;height:auto;display:block;margin:0 auto}\n.fpl-split-body h2{margin-bottom:16px}\n/* steps */\n.fpl-steps{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}\n.fpl-step{background:#fff;border:1px solid var(--fpl-border);border-radius:var(--fpl-r-xl);overflow:hidden;box-shadow:var(--fpl-shadow-xs)}\n.fpl-step-img{background:var(--fpl-grey50);border-bottom:1px solid var(--fpl-border);padding:20px;display:flex;align-items:center;justify-content:center;min-height:150px}\n.fpl-step-img img{max-width:100%;max-height:150px;height:auto}\n.fpl-step-body{padding:20px 22px 24px}\n.fpl-num{display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:var(--fpl-violet50);color:var(--fpl-violet600);font-weight:700;font-size:14px;margin-bottom:12px}\n/* card grids */\n.fpl-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}\n.fpl-grid--3{grid-template-columns:repeat(3,1fr)}\n.fpl-card{background:#fff;border:1px solid var(--fpl-border);border-radius:var(--fpl-r-xl);padding:24px}\n.fpl-ic{display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:10px;background:var(--fpl-violet50);color:var(--fpl-violet600);margin-bottom:14px}\n.fpl-ic svg{width:22px;height:22px}\n.fpl-tags{display:flex;flex-wrap:wrap;gap:6px;margin-top:12px}\n.fpl-tag{font-size:12px;font-weight:600;color:var(--fpl-violet700);background:var(--fpl-violet50);border-radius:var(--fpl-r-full);padding:3px 10px}\n@media(max-width:860px){\n.fpl-hero-inner,.fpl-split{grid-template-columns:1fr;gap:32px}\n.fpl-hero-art{order:-1}.fpl-split--rev .fpl-split-media{order:-1}\n.fpl-steps,.fpl-grid,.fpl-grid--3{grid-template-columns:1fr}\n.fpl-section{padding:52px 0}.fpl-hero{padding:48px 0 36px}\n}\n</style><style>.fpl-plug-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.fpl-plug{display:block;background:#fff;border:1px solid var(--fpl-border);border-radius:var(--fpl-r-xl);padding:26px;text-decoration:none;transition:border-color .15s,box-shadow .15s,transform .15s}.fpl-plug:hover{border-color:#c8b3f0;box-shadow:0 8px 24px -8px rgba(100,52,208,.25);transform:translateY(-2px)}.fpl-plug-logo{display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:12px;background:var(--fpl-grey50);border:1px solid var(--fpl-border);margin-bottom:16px}.fpl-plug-logo img{max-width:38px;max-height:30px;height:auto}.fpl-plug h3{font-size:18px;margin:0 0 8px;color:var(--fpl-fg1)}.fpl-plug p{margin:0 0 14px;font-size:14.5px;color:var(--fpl-fg2);line-height:1.6}.fpl-plug-link{font-size:14px;font-weight:600;color:var(--fpl-violet600)}@media(max-width:860px){.fpl-plug-grid{grid-template-columns:1fr}}</style><div class=\"fpl\"><section class=\"fpl-section\"><div class=\"fpl-container\"><div class=\"fpl-head\"><span class=\"fpl-eyebrow\">Why Formester</span><h2>One form builder for every website</h2></div><div class=\"fpl-grid fpl-grid--3\"><div class=\"fpl-card\"><span class=\"fpl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><circle cx=\"9\" cy=\"6\" r=\"1\"/><circle cx=\"9\" cy=\"12\" r=\"1\"/><circle cx=\"9\" cy=\"18\" r=\"1\"/><circle cx=\"15\" cy=\"6\" r=\"1\"/><circle cx=\"15\" cy=\"12\" r=\"1\"/><circle cx=\"15\" cy=\"18\" r=\"1\"/></svg></span><h4>Launch Forms in Minutes</h4><p>Set up forms fast without needing tech skills or dev support. Save time and go live in just a few clicks.</p></div><div class=\"fpl-card\"><span class=\"fpl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg></span><h4>Fits Right Into Your Website</h4><p>Works smoothly with WordPress, Webflow, Shopify and more. No need to rebuild or switch platforms.</p></div><div class=\"fpl-card\"><span class=\"fpl-ic\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><path d=\"M6 3v7a6 6 0 0 0 12 0V3\"/><path d=\"M6 3H3v7a9 9 0 0 0 18 0V3h-3\"/></svg></span><h4>Turn Visitors Into Leads</h4><p>Mobile-ready, fast-loading forms help boost submissions and capture more leads without drop-offs.</p></div></div></div></section></div>",
      "useContainer": false
    },
    {
      "id": 886,
      "__component": "micro-components.raw-html",
      "markup": "<div class=\"fpl\"><section class=\"fpl-section fpl-section--grey\" id=\"directory\"><div class=\"fpl-container\"><div class=\"fpl-head\"><span class=\"fpl-eyebrow\">Plugins</span><h2>Easily Add Smart, Responsive Forms</h2><p>Pick your platform and embed a Formester form in minutes — no coding required.</p></div><div class=\"fpl-plug-grid\"><a class=\"fpl-plug\" href=\"/plugins/wordpress/\"><span class=\"fpl-plug-logo\"><img src=\"/integrations/wordpress.svg\" alt=\"WordPress Form Plugin\"/></span><h3>WordPress Form Plugin</h3><p>Add responsive forms to any WordPress post or page. Perfect if you're looking for a contact form plugin or custom form builder.</p><span class=\"fpl-plug-link\">Learn more &rarr;</span></a><a class=\"fpl-plug\" href=\"/plugins/wix-forms/\"><span class=\"fpl-plug-logo\"><img src=\"/integrations/wix.svg\" alt=\"Wix Form Plugin\"/></span><h3>Wix Form Plugin</h3><p>Add smart forms directly to your Wix site. Drag, drop, and collect responses in real time.</p><span class=\"fpl-plug-link\">Learn more &rarr;</span></a><a class=\"fpl-plug\" href=\"/plugins/webflow/\"><span class=\"fpl-plug-logo\"><img src=\"/integrations/webflow.svg\" alt=\"Webflow Form Plugin\"/></span><h3>Webflow Form Plugin</h3><p>Embed any form that matches your Webflow design. Capture feedback, signups, and more without extra steps.</p><span class=\"fpl-plug-link\">Learn more &rarr;</span></a><a class=\"fpl-plug\" href=\"/plugins/shopify-form-builder/\"><span class=\"fpl-plug-logo\"><img src=\"/integrations/shopify.svg\" alt=\"Shopify Form Plugin\"/></span><h3>Shopify Form Plugin</h3><p>Create forms for product feedback, support requests, or order details, right inside your Shopify store.</p><span class=\"fpl-plug-link\">Learn more &rarr;</span></a><a class=\"fpl-plug\" href=\"/plugins/canva-form-builder/\"><span class=\"fpl-plug-logo\"><img src=\"/integrations/canva.svg\" alt=\"Canva Form Plugin\"/></span><h3>Canva Form Plugin</h3><p>Embed forms into your Canva website. Perfect for lead magnets, surveys, or quizzes.</p><span class=\"fpl-plug-link\">Learn more &rarr;</span></a><a class=\"fpl-plug\" href=\"/plugins/slack-forms/\"><span class=\"fpl-plug-logo\"><img src=\"/integrations/slack.png\" alt=\"Slack Forms\"/></span><h3>Slack Forms</h3><p>Build forms, surveys, and approvals right inside Slack.</p><span class=\"fpl-plug-link\">Learn more &rarr;</span></a></div></div></section></div>",
      "useContainer": false
    },
