      "blobColorC": "#f4efff",
      "mockupHtml": "<style>\n.fmh{position:relative;width:100%;max-width:430px;margin:0 auto;aspect-ratio:1}\n.fmh-ring{position:absolute;inset:7%;border:1.5px dashed #d6c7f5;border-radius:50%;animation:fmh-spin 44s linear infinite}\n.fmh-ring2{position:absolute;inset:24%;border:1px dashed #ebe2fc;border-radius:50%;animation:fmh-spin 60s linear infinite reverse}\n@keyframes fmh-spin{to{transform:rotate(360deg)}}\n.fmh::before{content:\"\";position:absolute;inset:0;background:radial-gradient(circle at 50% 50%,rgba(100,52,208,.10),transparent 62%)}\n.fmh-center{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);width:24%;aspect-ratio:1;background:#fff;border:1px solid #eaecf0;border-radius:22px;box-shadow:0 14px 34px -8px rgba(100,52,208,.38);display:flex;align-items:center;justify-content:center;z-index:2}\n.fmh-center img{width:60%;height:auto}\n.fmh-node{position:absolute;width:18%;aspect-ratio:1;transform:translate(-50%,-50%);background:#fff;border:1px solid #eaecf0;border-radius:16px;box-shadow:0 8px 20px -6px rgba(16,24,40,.16);display:flex;align-items:center;justify-content:center;z-index:1}\n.fmh-node img{max-width:58%;max-height:48%;height:auto}\n</style>\n<div class=\"fmh\"><div class=\"fmh-ring\"></div><div class=\"fmh-ring2\"></div>\n<div class=\"fmh-center\"><img src=\"/formester-icon.svg\" alt=\"Formester\"/></div>\n<div class=\"fmh-node\" style=\"left:50%;top:9%\"><img src=\"/integrations/wordpress.svg\" alt=\"WordPress\"/></div>\n<div class=\"fmh-node\" style=\"left:85%;top:30%\"><img src=\"/integrations/shopify.svg\" alt=\"Shopify\"/></div>\n<div class=\"fmh-node\" style=\"left:85%;top:70%\"><img src=\"/integrations/wix.svg\" alt=\"Wix\"/></div>\n<div class=\"fmh-node\" style=\"left:50%;top:91%\"><img src=\"/integrations/canva.svg\" alt=\"Canva\"/></div>\n<div class=\"fmh-node\" style=\"left:15%;top:70%\"><img src=\"/integrations/slack.png\" alt=\"Slack\"/></div>\n<div class=\"fmh-node\" style=\"left:15%;top:30%\"><img src=\"/integrations/webflow.svg\" alt=\"Webflow\"/></div>\n</div>",
