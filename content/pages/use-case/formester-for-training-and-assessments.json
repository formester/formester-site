        {
          "id": 943,
          "header": "Can I accept online payments?",
          "body": " Yes. Use credit card and banking fields to collect payments securely.",
          "body_markdown": " Yes. Use credit card and banking fields to collect payments securely.",
          "list": []
        },
        {
          "id": 947,
          "header": "What financial forms can I build?",
          "body": " Create tax forms, claim forms, KYC forms, invoice forms, insurance forms, and more.",
          "body_markdown": " Create tax forms, claim forms, KYC forms, invoice forms, insurance forms, and more.",
