      "faqList": [
        {
          "id": 941,
          "header": "Do I need coding skills?",
          "body": "No. You can build and customize any financial form without writing a single line of code.",
          "body_markdown": "No. You can build and customize any financial form without writing a single line of code.",
          "list": []
        },
        {
          "id": 936,
          "header": "Can I accept online payments?",
          "body": " Yes. Use credit card and banking fields to collect payments securely.",
          "body_markdown": " Yes. Use credit card and banking fields to collect payments securely.",
          "list": []
        },
        {
          "id": 939,
          "header": "What financial forms can I build?",
          "body": " Create tax forms, claim forms, KYC forms, invoice forms, insurance forms, and more.",
          "body_markdown": " Create tax forms, claim forms, KYC forms, invoice forms, insurance forms, and more.",
          "list": []
        },
        {
          "id": 938,
          "header": "Can I track submissions?",
          "body": " Yes. You get a full dashboard to track every wire transfer form, tax declaration, or loan request.",
          "body_markdown": " Yes. You get a full dashboard to track every wire transfer form, tax declaration, or loan request.",
          "list": []
        },
        {
          "id": 940,
          "header": "Is Formester secure?",
          "body": "Absolutely. All financial data is encrypted and stored securely.",
          "body_markdown": "Absolutely. All financial data is encrypted and stored securely.",
          "list": []
        },
        {
          "id": 937,
          "header": "Is it affordable?",
          "body": "Yes. Choose a plan that fits your needs. Free trial available.",
          "body_markdown": "Yes. Choose a plan that fits your needs. Free trial available.",
          "list": []
        },
        {
          "id": 942,
          "header": "Do you offer support?",
