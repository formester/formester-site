      "faqList": [
        {
          "id": 2704,
          "header": "What does the Amazon SES integration do?",
          "body": "It routes the emails your forms send — confirmations, notifications, and auto-replies — through your own Amazon SES account, so they come from your domain with Amazon SES's deliverability.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2705,
          "header": "How do I connect Amazon SES to Formester?",
          "body": "From your dashboard, open Integrations and click Add integration under Custom SMTP. In the Add SMTP Account modal, select Amazon SES as the service and enter your username, integration password, and from name and address — the port and SMTP server fill in for you.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2706,
          "header": "Which emails will use this integration?",
          "body": "Any form email you configure — respondent confirmations, internal alerts to your team, and automated replies.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2708,
          "header": "What if emails stop sending?",
          "body": "Check that your Amazon SES credentials are still valid and re-save the integration. If the issue continues, our support team can help.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2707,
          "header": "What is Formester?",
          "body": "Formester is an online form builder for creating forms, surveys, and quizzes with a drag-and-drop editor or AI. It connects with the tools your team already uses — Google Sheets, Slack, HubSpot, Zapier, and more — so your form data flows wherever you need it.",
          "body_markdown": "",
          "list": []
        }
      ]
