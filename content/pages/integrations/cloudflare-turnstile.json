      "faqList": [
        {
          "id": 2719,
          "header": "What does the Cloudflare Turnstile integration do?",
          "body": "It verifies that submissions come from real people, blocking automated bot and spam entries so your form data stays clean and reliable.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2723,
          "header": "How do I add Cloudflare Turnstile to a form?",
          "body": "Click Add Elements in the form builder, select Turnstile, and publish. Test it by submitting in preview mode.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2720,
          "header": "How is Turnstile different from a CAPTCHA?",
          "body": "Turnstile verifies most visitors invisibly — no image puzzles or checkboxes — so real users almost never see a challenge.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2721,
          "header": "Does it work on surveys and quizzes too?",
          "body": "Yes — the protection works on forms, surveys, and quizzes alike.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2722,
          "header": "What is Formester?",
          "body": "Formester is an online form builder for creating forms, surveys, and quizzes with a drag-and-drop editor or AI. It connects with the tools your team already uses — Google Sheets, Slack, HubSpot, Zapier, and more — so your form data flows wherever you need it.",
          "body_markdown": "",
          "list": []
        }
      ]
