        {
          "id": 285,
          "title": "Add the Turnstile element",
          "description": "Open your form, click Add Elements, and select Turnstile from the available options.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;margin-bottom:8px;'>Add Elements</div><div style='font-size:9.5px;font-weight:700;color:#697586;text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;'>Security</div><div style='display:flex;align-items:center;gap:8px;border:1px solid #6434d0;background:#faf8ff;border-radius:8px;padding:8px 11px;font-size:11px;color:#101828;font-weight:600;margin-bottom:5px;'>Turnstile<span style='margin-left:auto;color:#6434d0;font-weight:700;'>+</span></div><div style='display:flex;align-items:center;gap:8px;border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:11px;color:#697586;'>reCAPTCHA</div></div></div></div>",
          "image": null
        },
        {
          "id": 286,
          "title": "Publish your form",
          "description": "Click Publish to save the change — protection is active immediately.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;'>Publish changes</div><div style='display:flex;justify-content:space-between;align-items:center;font-size:10.5px;color:#101828;margin:7px 0;'>Turnstile enabled<span style='width:26px;height:15px;border-radius:999px;background:#6434d0;position:relative;display:inline-block;'><span style='position:absolute;top:2px;right:2px;width:11px;height:11px;border-radius:50%;background:#fff;'></span></span></div><div style='margin-top:11px;'><span style='font-size:10.5px;font-weight:700;color:#fff;background:#6434d0;border-radius:7px;padding:7px 16px;line-height:1;'>Publish</span></div></div></div></div>",
          "image": null
