      "__component": "macro-components.sticky-steps-section",
      "badge": "How it works",
      "heading": "Add Calendly in 3 steps",
      "description": "It's a form field — drop it in, point it at your Calendly link, publish.",
      "background": "#f9fafb",
      "steps": [
        {
          "id": 281,
          "title": "Add the Appointment Scheduler field",
          "description": "In the form builder, click Add Elements and pick Appointment Scheduler from the Date & Time category.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;margin-bottom:8px;'>Add Elements</div><div style='font-size:9.5px;font-weight:700;color:#697586;text-transform:uppercase;letter-spacing:.04em;margin-bottom:6px;'>Date & Time</div><div style='display:flex;align-items:center;gap:8px;border:1px solid #6434d0;background:#faf8ff;border-radius:8px;padding:8px 11px;font-size:11px;color:#101828;font-weight:600;margin-bottom:5px;'>Appointment Scheduler<span style='margin-left:auto;color:#6434d0;font-weight:700;'>+</span></div><div style='display:flex;align-items:center;gap:8px;border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:11px;color:#697586;'>Time</div></div></div></div>",
          "image": null
        },
        {
          "id": 283,
          "title": "Point it at your Calendly",
          "description": "In the field properties, choose Calendly under Schedule With and paste your Calendly link — you can also autofill the respondent's name and email into the booking.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;margin-bottom:8px;'>Scheduler · General Properties</div><div style='font-size:10.5px;font-weight:700;color:#101828;margin-bottom:4px;'>Scheduler Type</div><div style='display:flex;border:1px solid #eaecf0;border-radius:8px;overflow:hidden;margin-bottom:9px;'><span style='flex:1;text-align:center;font-size:10.5px;font-weight:700;color:#fff;background:#6434d0;padding:7px 0;'>Legacy</span><span style='flex:1;text-align:center;font-size:10.5px;color:#475467;padding:7px 0;'>Native</span></div><div style='font-size:10.5px;font-weight:700;color:#101828;margin-bottom:4px;'>Schedule With</div><div style='border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:10.5px;color:#101828;display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;'>Calendly<span style='font-size:8px;color:#697586;'>&#9662;</span></div><div style='font-size:10.5px;font-weight:700;color:#101828;margin-bottom:4px;'>Calendly Link</div><div style='border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:10px;color:#98a2b3;'>https://calendly.com/username</div></div></div></div>",
          "image": null
        },
