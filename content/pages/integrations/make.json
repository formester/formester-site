      "faqList": [
        {
          "id": 3504,
          "header": "What does the Make integration do?",
          "body": "It uses Formester as a Make trigger, so every new form submission can start scenarios across 2,000+ connected apps — CRMs, spreadsheets, email tools, and more.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 3505,
          "header": "How do I set up a scenario with Formester?",
          "body": "From the Automate tab, choose Make, then in Make create a scenario with Formester as the trigger, select your form, map fields, test, and turn it on.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 3508,
          "header": "Can one submission trigger multiple actions?",
          "body": "Yes — a Make scenario can run several modules from one submission, like creating a lead, sending an email, and adding a spreadsheet row.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 3507,
          "header": "What if my scenario stops running?",
          "body": "Check the scenario’s status and execution history in Make, and confirm the form’s integration is published in Formester. Submissions always stay stored in Formester.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 3506,
          "header": "What is Formester?",
          "body": "Formester is an online form builder for creating forms, surveys, and quizzes with a drag-and-drop editor or AI. It connects with the tools your team already uses — Google Sheets, Slack, HubSpot, Make, and more — so your form data flows wherever you need it.",
          "body_markdown": "",
          "list": []
        }
      ]
