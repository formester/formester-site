      "id": 174,
      "__component": "macro-components.hero-v2",
      "description": "Connect your Outlook or Microsoft 365 account and your forms send professional email as you. Recipients see a real address they recognize — which means better trust and better open rates.",
      "trustText": "✓ Native integration · ✓ OAuth sign-in, no passwords shared · ✓ Minutes to set up",
      "blobColorA": "#f5eeff",
      "blobColorB": "#f1ebff",
      "blobColorC": "#f4efff",
