      "id": 104,
      "__component": "macro-components.sticky-steps-section",
      "badge": "How it works",
      "heading": "Connect Notion in 3 steps",
      "description": "Connect your workspace, pick a database, and submissions flow in.",
      "background": "#f9fafb",
      "steps": [
        {
          "id": 316,
          "title": "Add Notion from the Automate tab",
          "description": "Open your form, head to Automate → Integrations, find Notion, and click Add integration.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='display:flex;gap:14px;font-size:10px;color:#697586;padding:0 4px 7px;'><span>Autoresponder</span><span style='color:#6434d0;font-weight:700;border-bottom:2px solid #6434d0;padding-bottom:5px;'>Integrations</span><span>Webhooks</span></div><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);overflow:hidden;'><div style='display:flex;align-items:center;gap:8px;padding:11px 13px 4px;'><img src='/integrations/notion.png' alt='' style='width:20px;height:20px;object-fit:contain;'/><span style='font-size:12.5px;font-weight:700;color:#101828;'>Notion</span></div><div style='padding:0 13px 10px;font-size:10.5px;color:#697586;line-height:1.45;'>Automatically sync form submissions to a Notion database.</div><div style='display:flex;justify-content:flex-end;border-top:1px solid #f2f4f7;padding:9px 13px;font-size:10.5px;'><span style='color:#6434d0;font-weight:700;'>+ Add integration</span></div></div></div></div>",
          "image": null
        },
        {
          "id": 317,
          "title": "Connect Notion and map your properties",
          "description": "Click Connect Notion to pick which pages and databases to share, select your workspace and database, then map Notion properties to your form questions. You can sync existing submissions too.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;'>Notion Integration</div><div style='font-size:10.5px;font-weight:700;color:#101828;margin:8px 0 4px;'>Notion Workspace</div><div style='border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:10.5px;color:#101828;display:flex;justify-content:space-between;align-items:center;'>Acme HQ<span style='font-size:8px;color:#697586;'>&#9662;</span></div><div style='font-size:10.5px;font-weight:700;color:#101828;margin:8px 0 4px;'>Database</div><div style='border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:10.5px;color:#101828;display:flex;justify-content:space-between;align-items:center;'>Form Profiles<span style='font-size:8px;color:#697586;'>&#9662;</span></div><div style='display:flex;align-items:center;gap:8px;font-size:10.5px;padding:7px 10px;background:#f9fafb;border:1px solid #eaecf0;border-radius:8px;margin:5px 0;'><span style='font-weight:600;color:#101828;'>Name</span><span style='color:#9777e0;'>→</span><span style='color:#475467;'>Full name</span></div><div style='display:flex;align-items:center;gap:8px;font-size:10.5px;padding:7px 10px;background:#f9fafb;border:1px solid #eaecf0;border-radius:8px;margin:5px 0;'><span style='font-weight:600;color:#101828;'>Email</span><span style='color:#9777e0;'>→</span><span style='color:#475467;'>Work email</span></div><div style='display:flex;justify-content:space-between;align-items:center;font-size:10.5px;color:#101828;margin:7px 0;'>Sync existing submissions<span style='width:26px;height:15px;border-radius:999px;background:#6434d0;position:relative;display:inline-block;'><span style='position:absolute;top:2px;right:2px;width:11px;height:11px;border-radius:50%;background:#fff;'></span></span></div><div style='margin-top:11px;'><span style='font-size:10.5px;font-weight:700;color:#fff;background:#6434d0;border-radius:7px;padding:7px 16px;line-height:1;'>Save Integration</span></div></div></div></div>",
          "image": null
        },
        {
          "id": 315,
          "title": "Publish and test",
          "description": "Publish the form and submit a test response — a new entry appears in your database instantly.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='display:inline-flex;align-items:center;gap:6px;font-size:10.5px;font-weight:700;color:#027a48;background:#ecfdf3;border-radius:999px;padding:7px 13px;'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.6' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12l4 4L19 6'/></svg>Entry added to Form Profiles</div></div></div>",
          "image": null
        }
