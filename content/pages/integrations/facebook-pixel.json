      "faqList": [
        {
          "id": 2724,
          "header": "What does the Meta Pixel integration do?",
          "body": "It tracks form views and submissions as Meta Pixel events, so you can measure ad-driven conversions, optimize campaigns, and retarget engaged visitors.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2725,
          "header": "How do I connect Meta Pixel?",
          "body": "Create a Pixel in Meta Events Manager, copy its ID, then paste it into your form's Automate → Integrations → Meta Pixel. Publish and you're tracking.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2727,
          "header": "Where do I find my Pixel ID?",
          "body": "In Meta Events Manager — open your Pixel and copy its ID, a long number like 896138278069703.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2726,
          "header": "How do I verify it works?",
          "body": "Install the Meta Pixel Helper Chrome extension and submit a test form — then confirm the events in Meta Events Manager.",
          "body_markdown": "",
          "list": []
        },
        {
          "id": 2728,
          "header": "What is Formester?",
          "body": "Formester is an online form builder for creating forms, surveys, and quizzes with a drag-and-drop editor or AI. It connects with the tools your team already uses — Google Sheets, Slack, HubSpot, Zapier, and more — so your form data flows wherever you need it.",
          "body_markdown": "",
          "list": []
        }
      ]
