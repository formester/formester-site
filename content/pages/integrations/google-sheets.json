      "id": 98,
      "__component": "macro-components.sticky-steps-section",
      "badge": "How it works",
      "heading": "Connect Google Sheets in 3 steps",
      "description": "From form to spreadsheet in about two minutes. No code, no Zapier required.",
      "background": "#f9fafb",
      "steps": [
        {
          "id": 297,
          "title": "Add Google Sheets from the Automate tab",
          "description": "Open your form, head to Automate → Integrations, find Google Sheets, and click Add integration.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;'><div style='display:flex;gap:14px;font-size:10px;color:#697586;padding:0 4px 7px;'><span>Autoresponder</span><span style='color:#6434d0;font-weight:700;border-bottom:2px solid #6434d0;padding-bottom:5px;'>Integrations</span><span>Webhooks</span></div><div style='border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);overflow:hidden;'><div style='display:flex;align-items:center;gap:8px;padding:11px 13px 4px;'><img src='/integrations/google-sheets.png' alt='' style='width:20px;height:20px;object-fit:contain;'/><span style='font-size:12.5px;font-weight:700;color:#101828;'>Google Sheets</span></div><div style='padding:0 13px 10px;font-size:10.5px;color:#697586;line-height:1.45;'>Automatically syncs your form data with spreadsheet.</div><div style='display:flex;justify-content:space-between;align-items:center;border-top:1px solid #f2f4f7;padding:9px 13px;font-size:10.5px;'><span style='color:#697586;text-decoration:underline;'>Watch Tutorial</span><span style='color:#6434d0;font-weight:700;'>+ Add integration</span></div></div></div></div>",
          "image": null
        },
        {
          "id": 298,
          "title": "Connect your Google account",
          "description": "Pick an account or add a new one — sign in with Google and allow access once. No API keys, no code.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;margin-bottom:6px;'>Google Account</div><div style='border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:10.5px;color:#697586;display:flex;justify-content:space-between;align-items:center;'>Select Google Account<span style='font-size:8px;color:#697586;'>&#9650;</span></div><div style='border:1px solid #eaecf0;border-radius:8px;margin-top:6px;overflow:hidden;box-shadow:0 4px 10px rgba(15,14,26,.05);'><div style='padding:8px 11px;font-size:10.5px;color:#101828;border-bottom:1px solid #f2f4f7;'>you@company.com</div><div style='padding:8px 11px;font-size:10.5px;color:#6434d0;font-weight:700;'>+ Add a new account</div></div></div></div>",
          "image": null
        },
        {
          "id": 296,
          "title": "Pick a spreadsheet and integrate",
          "description": "Create a new spreadsheet or paste the URL of an existing one — you can sync past submissions too. Hit Integrate and every response lands as a clean row.",
          "rawHtml": "<div class='raw-html-embed'><div style='font-family:Inter,ui-sans-serif,system-ui,sans-serif;max-width:320px;border:1px solid #eaecf0;border-radius:10px;background:#fff;box-shadow:0 4px 14px rgba(15,14,26,.06);padding:13px;'><div style='font-size:11px;font-weight:700;color:#101828;margin-bottom:7px;'>Choose An Option</div><div style='display:flex;align-items:center;gap:7px;font-size:10.5px;color:#475467;margin-bottom:5px;'><span style='width:12px;height:12px;border-radius:50%;border:1.5px solid #cdd5df;flex-shrink:0;'></span>Create a new spreadsheet</div><div style='display:flex;align-items:center;gap:7px;font-size:10.5px;color:#101828;margin-bottom:9px;'><span style='width:12px;height:12px;border-radius:50%;border:4px solid #6434d0;flex-shrink:0;box-sizing:border-box;'></span>Use an existing spreadsheet</div><div style='font-size:10.5px;font-weight:700;color:#101828;margin-bottom:4px;'>Spreadsheet Url<span style='color:#e02b2b;'>*</span></div><div style='border:1px solid #eaecf0;border-radius:8px;padding:8px 11px;font-size:10px;color:#98a2b3;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>https://docs.google.com/spreadsheets/d/1AtrHw</div><div style='display:flex;align-items:center;gap:7px;font-size:10.5px;color:#475467;margin:9px 0 11px;'><span style='width:13px;height:13px;border-radius:4px;background:#6434d0;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;'><svg width='9' height='9' viewBox='0 0 24 24' fill='none' stroke='#fff' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12l4 4L19 6'/></svg></span>Add existing submission to the sheet</div><div style='display:flex;gap:8px;'><span style='font-size:10.5px;font-weight:700;color:#fff;background:#6434d0;border-radius:7px;padding:7px 16px;line-height:1;'>Integrate</span><span style='font-size:10.5px;font-weight:600;color:#475467;border:1px solid #eaecf0;border-radius:7px;padding:7px 14px;line-height:1;'>Cancel</span></div></div></div>",
          "image": null
        }
