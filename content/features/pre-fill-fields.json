    },
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "What is a pre-filled form?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "It's a form that already has certain fields completed before the respondent opens it. They only fill in what's left, so the form feels shorter and faster to finish.",
            "@type": "Answer"
          }
        },
        {
          "name": "How does a pre-fill link work?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "You add the values you already know to the form's URL as parameters, or set them up in the Share tab. Each respondent gets a unique link that opens their form with those fields already populated.",
            "@type": "Answer"
          }
        },
        {
          "name": "Can I pre-fill only some of the fields?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Pre-fill any combination of fields and leave the rest blank for the respondent to complete. You decide which details to carry in and which to ask for.",
            "@type": "Answer"
          }
        },
        {
          "name": "Does pre-filling work for long surveys?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Absolutely. Pre-filling repetitive details like name, company, or past answers removes a lot of typing, which makes long surveys far easier to complete.",
            "@type": "Answer"
          }
        },
        {
          "name": "Can respondents edit the values I pre-fill?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Pre-filled values are editable by default, so respondents can confirm or correct them before submitting — giving you cleaner, verified data.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is pre-fill available to all users?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. You can build a form, set up pre-fill links, and share them with respondents — get started for free.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
