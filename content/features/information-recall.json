    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "What is information recall and how does it work?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Information recall lets you use the @ sign to pull a respondent's earlier answers into later fields, labels, endings, or emails. Type @ followed by a field name wherever you want that answer to appear, and Formester fills in the value automatically as the form is filled out.",
            "@type": "Answer"
          }
        },
        {
          "name": "Can I recall information into multiple fields or emails?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Use the @ sign to recall an answer into any number of fields, question labels, ending screens, or email notifications — making it easy to create personalised messages and forms that reuse relevant data from earlier responses.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is the recalled information always accurate and up to date?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Recall retrieves the most recent answer the respondent submitted for that field, so the value always reflects their latest input and stays consistent everywhere it appears.",
            "@type": "Answer"
          }
        },
        {
          "name": "Do I need to set anything up to use information recall?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "No special setup is needed. Simply type the @ sign followed by the field name wherever you want to recall an answer, and Formester fetches the matching response automatically when the form is filled out.",
            "@type": "Answer"
          }
        },
        {
          "name": "What can I recall besides answers?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Alongside answers you can recall variables, hidden field values, quiz scores, and calculated prices. That lets you show a personalised result on an ending screen, segment respondents by a hidden source, or display a price that updates from earlier answers.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is information recall free to use?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Build a form, reference earlier answers with the @ sign, and collect personalised responses for free — no code and no extra setup.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
