    {
      "id": 1227,
      "__component": "macro-components.faqs",
      "description": null,
      "centered": true,
      "title": [
        {
          "id": 4618,
          "text": "Calculation field FAQs",
          "highlight": false,
          "color": "#475467",
          "bold": false
        }
      ],
      "faqList": [
        {
          "id": 2256,
          "header": "What is a calculation field?",
          "body": "A calculation field is a form field that automatically computes a value — like a total, tax, fee, or score — from the answers a respondent gives, and updates it in real time as they type.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2257,
          "header": "How do I reference other fields in a formula?",
          "body": "Use the @ sign to reference earlier fields in your form. For example, on a payment form you can multiply @price by @quantity to get the total cost, with no code.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2258,
          "header": "What can I calculate?",
          "body": "Totals, subtotals, taxes, discounts, multi-step pricing, quotes, estimates, monthly payments, and quiz or assessment scores — anything you can express as a formula across your fields.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2259,
          "header": "Does the total update in real time?",
          "body": "Yes. Every calculation field recomputes the moment someone changes an input, so respondents see accurate numbers before they submit the form.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2261,
          "header": "Can the calculated total feed a payment?",
          "body": "Yes. You can send a calculated total to a payment field so customers are charged the exact amount your form works out — ideal for order, booking, and quote forms.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2260,
          "header": "Do I need to write any code?",
          "body": "No. You build the formula by referencing fields from the form builder and choosing the operations you need — no coding required.",
          "body_markdown": null,
          "list": []
        }
      ]
    },
