    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "What is a calculation field?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "A calculation field is a form field that automatically computes a value — like a total, tax, fee, or score — from the answers a respondent gives, and updates it in real time as they type.",
            "@type": "Answer"
          }
        },
        {
          "name": "How do I reference other fields in a formula?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Use the @ sign to reference earlier fields in your form. For example, on a payment form you can multiply @price by @quantity to get the total cost, with no code.",
            "@type": "Answer"
          }
        },
        {
          "name": "What can I calculate?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Totals, subtotals, taxes, discounts, multi-step pricing, quotes, estimates, monthly payments, and quiz or assessment scores — anything you can express as a formula across your fields.",
            "@type": "Answer"
          }
        },
        {
          "name": "Does the total update in real time?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Every calculation field recomputes the moment someone changes an input, so respondents see accurate numbers before they submit the form.",
            "@type": "Answer"
          }
        },
        {
          "name": "Can the calculated total feed a payment?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. You can send a calculated total to a payment field so customers are charged the exact amount your form works out — ideal for order, booking, and quote forms.",
            "@type": "Answer"
          }
        },
        {
          "name": "Do I need to write any code?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "No. You build the formula by referencing fields from the form builder and choosing the operations you need — no coding required.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
