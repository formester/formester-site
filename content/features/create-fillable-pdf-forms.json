    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "How do I create a fillable PDF in Formester?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Open the PDF Editor from the nav bar and choose how to start: create the PDF with AI, build it from scratch, or upload your own PDF template. If you upload a template, map your form fields onto it. Then connect the editor to your form — when someone submits, their answers populate the PDF and a finished document is produced.",
            "@type": "Answer"
          }
        },
        {
          "name": "What are the three ways to create a PDF?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "In the PDF Editor you can Create with AI (describe the document and let AI draft it), build From scratch (lay out the PDF yourself), or Upload a PDF template (bring an existing document and map your form fields onto it). All three end the same way: the form's answers fill the PDF on every submission.",
            "@type": "Answer"
          }
        },
        {
          "name": "What's the difference between this and converting a PDF to a form?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Converting a PDF turns an existing static PDF into a web form people fill out online. The PDF Editor works the other way: you build or upload a PDF document, map your form fields onto it, and every form submission populates that PDF — so you get back a finished, ready-to-send file.",
            "@type": "Answer"
          }
        },
        {
          "name": "Where do I find the PDF Editor?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "The PDF Editor is a tool in the app's nav bar. Click it to open the editor, then pick how you want to create your PDF — with AI, from scratch, or by uploading a template.",
            "@type": "Answer"
          }
        },
        {
          "name": "Do I need special software or coding to build a PDF?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "No. Everything happens inside Formester in the browser. Generating with AI, designing from scratch, and mapping form fields onto an uploaded template are all point-and-click — there's nothing to install and no code to write.",
            "@type": "Answer"
          }
        },
        {
          "name": "What kinds of fields can I map onto the PDF?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Any answer your form collects — text, dates, dropdowns, checkboxes, numbers, and signature fields — can be mapped onto the PDF and positioned exactly where it belongs, so every submission fills it correctly.",
            "@type": "Answer"
          }
        },
        {
          "name": "When does the PDF get filled in?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Automatically, the moment a response comes in. As people submit your form, their answers flow onto the PDF you built or uploaded and a completed copy is produced for you to download or send.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is my data secure?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Your documents and responses are encrypted and stored securely, and you control who on your team can access each form's data and generated PDFs.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
