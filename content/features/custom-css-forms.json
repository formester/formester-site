    {
      "id": 40,
      "__component": "macro-components.sticky-steps-section",
      "badge": "How it works",
      "heading": "Style your form in four steps",
      "description": "Build the form, open the design tab, pick what to style, then preview and publish.",
      "background": "#f9fafb",
      "steps": [
        {
          "id": 131,
          "title": "Open the design tab",
          "description": "Create your form with the AI form builder, then open it and click the Design tab at the top — every styling option lives here.",
          "rawHtml": "<div style='display:flex;align-items:center;gap:6px;background:#fff;border:1px solid #eaecf0;border-radius:10px;padding:6px;'><span style='font-size:12px;color:#697586;padding:6px 12px;line-height:1.1;'>Build</span><span style='font-size:12px;font-weight:600;color:#fff;background:#6434d0;border-radius:7px;padding:6px 14px;line-height:1.1;'>Design</span><span style='font-size:12px;color:#697586;padding:6px 12px;line-height:1.1;'>Share</span></div>",
          "image": null
        },
        {
          "id": 130,
          "title": "Turn on CSS Selector Mode",
          "description": "Scroll to the Custom CSS section and switch on CSS Selector Mode — this lets you target the whole form or any single element.",
          "rawHtml": "<div style='display:flex;align-items:center;gap:10px;background:#fff;border:1px solid #eaecf0;border-radius:10px;padding:10px 12px;'><span style='font-size:12px;font-weight:600;color:#101828;line-height:1.1;'>CSS Selector Mode</span><span style='margin-left:auto;width:34px;height:19px;border-radius:999px;background:#6434d0;position:relative;'><span style='position:absolute;top:2px;right:2px;width:15px;height:15px;border-radius:50%;background:#fff;'></span></span></div>",
          "image": null
        },
        {
          "id": 132,
          "title": "Pick what to style",
          "description": "Hover the whole form, or a single field, title, or button. Add a class selector to style all fields of a type, or an individual selector for just one.",
          "rawHtml": "<div style='display:flex;flex-direction:column;gap:8px;'><div style='display:flex;align-items:center;gap:8px;border:1px solid #eaecf0;border-radius:9px;padding:8px 11px;font-size:11.5px;color:#101828;'><span style='font-family:ui-monospace,Menlo,monospace;color:#6434d0;background:#f0ebfa;border-radius:6px;padding:2px 7px;line-height:1.1;'>.fm-input</span><span style='margin-left:auto;color:#697586;'>Class selector</span></div><div style='display:flex;align-items:center;gap:8px;border:1px solid #6434d0;border-radius:9px;padding:8px 11px;font-size:11.5px;color:#101828;box-shadow:0 0 0 3px #f0ebfa;'><span style='font-family:ui-monospace,Menlo,monospace;color:#6434d0;background:#f0ebfa;border-radius:6px;padding:2px 7px;line-height:1.1;'>#email-field</span><span style='margin-left:auto;color:#697586;'>Individual</span></div></div>",
          "image": null
        },
        {
          "id": 133,
          "title": "Preview and publish",
          "description": "Check the form on desktop, tablet, and mobile to be sure every style holds. When it looks right, save and publish to go live.",
          "rawHtml": "<div style='display:flex;align-items:center;gap:9px;border:1px solid #6434d0;border-radius:9px;padding:8px 11px;font-size:12.5px;color:#101828;background:#fff;box-shadow:0 4px 12px rgba(100,52,208,.16);'><span style='width:18px;height:18px;border-radius:50%;background:#ecfdf3;color:#027a48;display:inline-flex;align-items:center;justify-content:center;'><svg width='12' height='12' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2.6'><path d='M5 12l4 4L19 6'/></svg></span><span style='font-weight:600;'>Published</span><span style='margin-left:auto;font-size:11px;color:#697586;'>Looks great on every device</span></div>",
          "image": null
        }
      ],
      "buttons": []
