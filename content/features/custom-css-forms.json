          "body": "Recolor accents, focus rings, and the submit button to your exact brand hex."
        },
        {
          "id": 62,
          "label": "Custom font",
          "body": "Switch the form to your brand typeface so the copy matches your website and emails."
        },
        {
          "id": 64,
          "label": "Button radius",
          "body": "Set the corner radius and padding on the submit button — from sharp corners to a fully rounded pill."
        }
      ]
