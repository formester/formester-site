      "title": [
        {
          "id": 4894,
          "text": "Summary analytics FAQs",
          "highlight": false,
          "color": "#475467",
          "bold": false
        }
      ],
      "faqList": [
        {
          "id": 2449,
          "header": "What is summary analytics?",
          "body": "Summary analytics breaks down responses to multiple-choice, picture-choice, and rating questions like a poll result, so you can see how many people chose each option — as a percentage — without reviewing every submission.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2450,
          "header": "Which questions does it summarise?",
          "body": "Choice-style questions — multiple-choice, picture-choice, and rating-scale. Each one gets its own per-option breakdown so you can read the trend question by question.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2451,
          "header": "Where do I find the summary?",
          "body": "Open your form, go to Results, then the Summary tab. You'll see an organised breakdown of how respondents answered each choice question.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2452,
          "header": "How is this different from form analytics?",
          "body": "Summary analytics is about answers — how people responded to each question. Form analytics is about behaviour — views, submissions, time to complete, and where people drop off.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2454,
          "header": "What can I use it for?",
          "body": "Surveys, polls, quizzes, and feedback forms — customer feedback, employee satisfaction, market research, and event feedback are common uses.",
          "body_markdown": null,
          "list": []
        },
        {
          "id": 2453,
          "header": "Is summary analytics available for free?",
          "body": "Yes. Build a survey, collect responses, and view the summary breakdown for free.",
          "body_markdown": null,
          "list": []
        }
      ]
    },
