    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "What is summary analytics?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Summary analytics breaks down responses to multiple-choice, picture-choice, and rating questions like a poll result, so you can see how many people chose each option — as a percentage — without reviewing every submission.",
            "@type": "Answer"
          }
        },
        {
          "name": "Which questions does it summarise?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Choice-style questions — multiple-choice, picture-choice, and rating-scale. Each one gets its own per-option breakdown so you can read the trend question by question.",
            "@type": "Answer"
          }
        },
        {
          "name": "Where do I find the summary?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Open your form, go to Results, then the Summary tab. You'll see an organised breakdown of how respondents answered each choice question.",
            "@type": "Answer"
          }
        },
        {
          "name": "How is this different from form analytics?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Summary analytics is about answers — how people responded to each question. Form analytics is about behaviour — views, submissions, time to complete, and where people drop off.",
            "@type": "Answer"
          }
        },
        {
          "name": "What can I use it for?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Surveys, polls, quizzes, and feedback forms — customer feedback, employee satisfaction, market research, and event feedback are common uses.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is summary analytics available for free?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Build a survey, collect responses, and view the summary breakdown for free.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
