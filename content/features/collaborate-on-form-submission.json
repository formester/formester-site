    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "What does it mean to collaborate on a form submission?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "It means several people fill out one shared form at the same time. Instead of one person completing everything alone or passing a draft around, your whole team works on the same submission together and submits a single response.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is the collaboration really in real time?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Everyone filling the form sees each other's answers appear the moment they're typed, just like a shared document. There's no refreshing and no re-sending drafts — the form stays in sync for everyone on it.",
            "@type": "Answer"
          }
        },
        {
          "name": "Can I see who is filling which field?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Formester shows field-level presence: the field a teammate is on is highlighted in their colour with their avatar, so you can see at a glance who is filling what. Two people never unknowingly type into the same answer.",
            "@type": "Answer"
          }
        },
        {
          "name": "Can each person complete just their part of a long form?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. Split a long form across the right people so each person completes the section they own — finance fills the budget, legal fills the terms, the requester fills the basics — all on the same form at once.",
            "@type": "Answer"
          }
        },
        {
          "name": "Does everyone need their own account to fill the form together?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Collaborators join the same shared form so their presence shows up live. You control who can join and fill, so the right people are on the form together and the response stays clean.",
            "@type": "Answer"
          }
        },
        {
          "name": "Which plan includes collaborative form filling?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Collaborating on a form submission with real-time, field-level presence is available on the Business plan.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
