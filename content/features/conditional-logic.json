    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {
          "name": "What is a conditional logic form?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "It's a form that changes based on the answers people give — showing, hiding, or skipping questions so each respondent sees only what's relevant to them.",
            "@type": "Answer"
          }
        },
        {
          "name": "What can conditional logic do?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Show or hide fields, skip to other pages, reveal follow-up questions, and trigger conditional follow-ups like targeted emails or confirmation messages.",
            "@type": "Answer"
          }
        },
        {
          "name": "Do I need to code it?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "No. You pick the conditions and the fields to show or hide from drop-downs — no coding required.",
            "@type": "Answer"
          }
        },
        {
          "name": "Does it work on surveys and payment forms?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Yes. It works across surveys, registration, application, and payment forms — including updating options or totals based on a choice.",
            "@type": "Answer"
          }
        },
        {
          "name": "Do hidden fields still collect data?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "No — only the fields a respondent actually sees are collected, which keeps your data clean and relevant.",
            "@type": "Answer"
          }
        },
        {
          "name": "Is conditional logic available on the free plan?",
          "@type": "Question",
          "acceptedAnswer": {
            "text": "Conditional logic is available on the Personal plan and up. Check the pricing page for details.",
            "@type": "Answer"
          }
        }
      ]
    }
  ],
