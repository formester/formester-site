# Nuxt Studio is local-dev-only in this repo (see the studioEnabled comment
# in nuxt.config.js) — it never loads in the production static build.
# Set this to "true" in your local .env to turn it on for `nuxt dev`.
# Do NOT set this in Amplify/Netlify/CI env vars.
STUDIO_ENABLED=true

# Nuxt Studio external media storage (via @nuxthub/core blob binding).
# Only read when STUDIO_ENABLED=true. Point these at the same S3 bucket
# the CMS already uses today (@strapi/provider-upload-aws-s3), or a
# dedicated bucket/prefix — either works, Studio just needs read/write
# access. If unset, blob storage falls back to the local filesystem
# (fine for `nuxt dev`, which is the only place this ever runs).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_REGION=
# Only needed for non-AWS S3-compatible endpoints (R2, MinIO, ...). Leave
# unset for a real AWS S3 bucket.
S3_ENDPOINT=
